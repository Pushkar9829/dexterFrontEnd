# Copy to .env and fill in. VITE_* values are baked into the build and visible in the browser: no secrets here.

# Backend base URL for the browser, e.g. https://api.example.com
# Leave empty when the UI and API share an origin (dev proxy below, or the API serving the built UI).
# If set to another origin, add this UI's origin to CORS_ORIGINS in the backend .env.
VITE_API_URL=

# 1 shows the demo-logins panel on the login page in a production build (always shown in dev)
VITE_DEMO_LOGINS=1

# --- Dev server only (npm run dev) ---
DEV_PORT=5173
# Where the dev server forwards /api requests
API_PROXY_TARGET=http://127.0.0.1:4000
